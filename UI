        }

        function getStatusClass(status) {
            switch(status) {
                case 'Watched': return 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                case 'In Progress': return 'bg-blue-500/20 text-blue-300 border border-blue-500/30';
