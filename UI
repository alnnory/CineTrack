        // Helper: Canvas Poster Renderer to generate high-fidelity cosmic artwork without external dependencies
        function renderPosterCanvas(canvasId, colors, titleText) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Set internal resolution
            canvas.width = 400;
            canvas.height = 600;

            const c1 = colors[0] || '#7B2CDB';
            const c2 = colors[1] || '#EC168C';
            const c3 = colors[2] || '#0B0614';
            const c4 = colors[3] || '#F5C542';

            // Background Gradient
            const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            grad.addColorStop(0, c3);
            grad.addColorStop(0.5, c1);
            grad.addColorStop(1, c3);
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Swirling Nebula Orbs
            for (let i = 0; i < 4; i++) {
                ctx.save();
                ctx.beginPath();
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = 80 + Math.random() * 120;
                const radGrad = ctx.createRadialGradient(x, y, 10, x, y, r);
                radGrad.addColorStop(0, c2);
                radGrad.addColorStop(0.8, c1);
                radGrad.addColorStop(1, 'transparent');
                ctx.fillStyle = radGrad;
                ctx.globalAlpha = 0.45;
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Starfield Clusters
            ctx.fillStyle = '#FFFFFF';
            for (let i = 0; i < 120; i++) {
                const sx = Math.random() * canvas.width;
                const sy = Math.random() * canvas.height;
                const sz = Math.random() * 2;
                ctx.globalAlpha = Math.random() * 0.9;
                ctx.fillRect(sx, sy, sz, sz);
            }

            // Cosmic Geometric Rings / Grid
            ctx.save();
            ctx.translate(canvas.width / 2, canvas.height / 2 - 30);
            ctx.strokeStyle = c4;
            ctx.lineWidth = 1.5;
            ctx.globalAlpha = 0.35;
            ctx.beginPath();
            ctx.arc(0, 0, 90, 0, Math.PI * 2);
            ctx.stroke();

            ctx.strokeStyle = '#FFFFFF';
            ctx.globalAlpha = 0.2;
            ctx.beginPath();
            ctx.arc(0, 0, 130, 0, Math.PI * 2);
            ctx.stroke();

            // Diamond emblem
            ctx.rotate(45 * Math.PI / 180);
            ctx.strokeStyle = c2;
            ctx.globalAlpha = 0.5;
            ctx.strokeRect(-50, -50, 100, 100);
            ctx.restore();

            // Dark bottom vignette for title legibility
            const botGrad = ctx.createLinearGradient(0, canvas.height - 180, 0, canvas.height);
            botGrad.addColorStop(0, 'transparent');
            botGrad.addColorStop(1, '#0B0614');
            ctx.fillStyle = botGrad;
            ctx.globalAlpha = 0.95;
            ctx.fillRect(0, canvas.height - 200, canvas.width, 200);

            // Title Graphic on Poster
            ctx.globalAlpha = 1.0;
            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 24px Outfit, sans-serif';
            ctx.textAlign = 'center';
            
            // Wrap text if needed
            const words = titleText.split(' ');
            if (words.length > 2) {
                ctx.fillText(words.slice(0, 2).join(' '), canvas.width / 2, canvas.height - 70);
                ctx.fillStyle = c4;
                ctx.fillText(words.slice(2).join(' '), canvas.width / 2, canvas.height - 40);
            } else {
                ctx.fillText(titleText, canvas.width / 2, canvas.height - 50);
            }
        }

