        // Toggle Watchlist State
        function toggleWatchlist(movieId) {
            const movie = movieData.find(m => m.id === movieId);
            if (!movie) return;

            movie.isWatchlist = !movie.isWatchlist;
            showToast(movie.isWatchlist ? `Added "${movie.title}" to Watchlist` : `Removed "${movie.title}" from Watchlist`);

            // Update stats counter
            updateStats();
            renderGrids();

            // Update Hero button if it's the hero movie
            if (movieId === 'hero-featured') {
                const icon = document.getElementById('hero-watchlist-icon');
                const text = document.getElementById('hero-watchlist-text');
                if (icon && text) {
                    icon.className = movie.isWatchlist ? 'fa-solid fa-check text-emerald-400' : 'fa-solid fa-plus text-brand-magenta';
                    text.innerText = movie.isWatchlist ? 'In Your Watchlist' : 'Add Featured to Watchlist';
                }
            }
        }

        // Toggle Favorite State
        function toggleFavorite(movieId) {
            const movie = movieData.find(m => m.id === movieId);
            if (!movie) return;

            movie.isFavorite = !movie.isFavorite;
            showToast(movie.isFavorite ? `Favorited "${movie.title}"` : `Removed "${movie.title}" from Favorites`);

            updateStats();
            renderGrids();
        }

        // Update Dynamic Stats Counter
        function updateStats() {
            const total = movieData.length;
            const watched = movieData.filter(m => m.status === 'Watched').length;
            const toWatch = movieData.filter(m => m.isWatchlist).length;
            const favorites = movieData.filter(m => m.isFavorite).length;

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-watched').innerText = watched;
            document.getElementById('stat-towatch').innerText = toWatch;
            document.getElementById('stat-favorites').innerText = favorites;

            const navCount = document.getElementById('nav-watchlist-count');
            if (navCount) navCount.innerText = toWatch;
        }

        // Open Movie Detail Modal
        function openMovieModal(movieId) {
            const movie = movieData.find(m => m.id === movieId);
            if (!movie) return;

            document.getElementById('modalTitle').innerText = movie.title;
            document.getElementById('modalGenre').innerText = movie.genre;
            document.getElementById('modalMeta').innerText = `${movie.year} • ${movie.duration} • Directed by Cosmic Visionary`;
            document.getElementById('modalOverview').innerText = movie.overview;
            document.getElementById('modalRating').innerHTML = `<i class="fa-solid fa-star gold-star text-lg"></i> ${movie.rating}`;
            document.getElementById('modalStatusTag').innerText = `Status: ${movie.status}`;

            // Render Modal Poster Canvas
            renderPosterCanvas('modalCanvas', movie.colors, movie.title);

            // Modal Buttons
            const wlBtn = document.getElementById('modalWatchlistBtn');
            wlBtn.onclick = () => { toggleWatchlist(movie.id); openMovieModal(movie.id); };
            wlBtn.innerHTML = movie.isWatchlist ? '<i class="fa-solid fa-check"></i> On Watchlist' : '<i class="fa-solid fa-plus"></i> Add to Watchlist';

            const favBtn = document.getElementById('modalFavBtn');
            favBtn.onclick = () => { toggleFavorite(movie.id); openMovieModal(movie.id); };
            favBtn.innerHTML = movie.isFavorite ? '<i class="fa-solid fa-heart text-brand-magenta"></i> Favorited' : '<i class="fa-regular fa-heart"></i> Favorite';

            const modal = document.getElementById('movieModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeMovieModal() {
            const modal = document.getElementById('movieModal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // Toast Notification System
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            if (!toast || !toastMsg) return;

            toastMsg.innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Search Input Filtering
        document.getElementById('searchInput')?.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            if (!query) {
                renderGrids();
                return;
            }

            const filtered = movieData.filter(m => 
                m.title.toLowerCase().includes(query) || 
                m.genre.toLowerCase().includes(query)
            );

            const popularGrid = document.getElementById('popularGrid');
            if (popularGrid) {
                if (filtered.length === 0) {
                    popularGrid.innerHTML = `<div class="col-span-full py-12 text-center text-brand-muted text-sm glass-card rounded-2xl">No movies found matching "${query}"</div>`;
                } else {
                    popularGrid.innerHTML = filtered.map(m => createMovieCardHTML(m)).join('');
                    filtered.forEach(m => renderPosterCanvas(`canvas-${m.id}`, m.colors, m.title));
                }
            }
        });

        window.onload = function() {
            // Render hero canvas poster artwork
            const heroMovie = movieData.find(m => m.id === 'hero-featured');
            if (heroMovie) {
                renderPosterCanvas('featuredCanvas', heroMovie.colors, heroMovie.title);
            }

            // Render UI sections
            renderGenreButtons();
            renderGrids();
            updateStats();
        };
    </script>
</body>
</html>
