<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineTrack: Your Movies, Your Story</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter and Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#0B0614',
                            deep: '#130A20',
                            card: '#211432',
                            cardHover: '#2A1A40',
                            accent: '#7B2CDB',
                            violet: '#A855F7',
                            magenta: '#EC168C',
                            gold: '#F5C542',
                            text: '#FFFFFF',
                            muted: '#C4B8D4',
                            border: '#3B205C'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    boxShadow: {
                        'cosmic-glow': '0 0 25px -5px rgba(123, 44, 219, 0.5), 0 0 15px -5px rgba(236, 22, 140, 0.3)',
                        'magenta-glow': '0 0 20px 0px rgba(236, 22, 140, 0.4)',
                        'gold-glow': '0 0 15px 0px rgba(245, 197, 66, 0.3)',
                        'card-depth': '0 10px 30px -10px rgba(0, 0, 0, 0.7)',
                    },
                    backgroundImage: {
                        'cosmic-gradient': 'radial-gradient(ellipse at 70% 20%, rgba(236, 22, 140, 0.25) 0%, rgba(123, 44, 219, 0.35) 40%, rgba(19, 10, 32, 0.95) 80%, rgba(11, 6, 20, 1) 100%)',
                        'purple-btn': 'linear-gradient(135deg, #7B2CDB 0%, #A855F7 100%)',
                        'magenta-btn': 'linear-gradient(135deg, #EC168C 0%, #7B2CDB 100%)',
                        'card-gradient': 'linear-gradient(180deg, rgba(33, 20, 50, 0.7) 0%, rgba(19, 10, 32, 0.9) 100%)',
                        'nebula-overlay': 'radial-gradient(circle at 50% 50%, rgba(168, 85, 247, 0.15) 0%, transparent 60%)'
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0614;
        }
        ::-webkit-scrollbar-thumb {
            background: #3B205C;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7B2CDB;
        }

        /* Ambient Glow Animations */
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.03); }
        }
        .animate-pulse-glow {
            animation: pulseGlow 6s infinite ease-in-out;
        }

        @keyframes floatEffect {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: floatEffect 5s infinite ease-in-out;
        }

        /* Glassmorphic Effects */
        .glass-nav {
            background: rgba(19, 10, 32, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(123, 44, 219, 0.2);
        }
        .glass-card {
            background: rgba(33, 20, 50, 0.65);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(123, 44, 219, 0.2);
        }
        .glass-card:hover {
            border-color: rgba(168, 85, 247, 0.5);
        }

        /* Custom Star Rating Glow */
        .gold-star {
            color: #F5C542;
            text-shadow: 0 0 8px rgba(245, 197, 66, 0.5);
        }

        /* Canvas Poster Shadow */
        .poster-container {
            position: relative;
            overflow: hidden;
        }
        .poster-container::after {
            content: '';
            position: absolute;
            inset: 0;
            box-shadow: inset 0 0 20px rgba(11, 6, 20, 0.8);
            pointer-events: none;
        }
    </style>
</head>

<body class="bg-brand-bg text-brand-text font-sans antialiased min-h-screen flex flex-col selection:bg-brand-accent selection:text-white">

    <!-- NAVIGATION BAR -->
    <header class="sticky top-0 z-50 glass-nav transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-accent via-brand-magenta to-brand-gold p-[2px] shadow-cosmic-glow transform group-hover:rotate-6 transition-transform">
                    <div class="w-full h-full bg-brand-bg rounded-[10px] flex items-center justify-center">
                        <i class="fa-solid font-black fa-film text-brand-gold text-lg"></i>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-display font-extrabold text-2xl tracking-tight text-white flex items-center gap-1">
                        Cine<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-violet to-brand-magenta">Track</span>
                    </span>
                    <span class="text-[9px] tracking-widest text-brand-muted uppercase font-semibold -mt-1">Your Movies. Your Story.</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-1 bg-brand-deep/80 px-4 py-1.5 rounded-full border border-brand-border/50">
                <a href="#home" class="px-4 py-2 rounded-full text-sm font-semibold text-white bg-brand-accent/30 border border-brand-accent/50 shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-house text-xs text-brand-gold"></i> Home
                </a>
                <a href="#movies" class="px-4 py-2 rounded-full text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-card/50 transition-colors">Movies</a>
                <a href="#watchlist" class="px-4 py-2 rounded-full text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-card/50 transition-colors flex items-center gap-1.5">
                    Watchlist <span id="nav-watchlist-count" class="bg-brand-accent text-xs text-white px-1.5 py-0.5 rounded-full font-bold">15</span>
                </a>
                <a href="#watched" class="px-4 py-2 rounded-full text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-card/50 transition-colors">Watched</a>
                <a href="#favorites" class="px-4 py-2 rounded-full text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-card/50 transition-colors">Favorites</a>
                <a href="#reviews" class="px-4 py-2 rounded-full text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-card/50 transition-colors">Reviews</a>
            </nav>

            <!-- Actions & Search & Profile -->
            <div class="flex items-center gap-3 sm:gap-4">
                <!-- Interactive Search Bar -->
                <div class="relative group">
                    <input type="text" id="searchInput" placeholder="Search universe..." 
                           class="bg-brand-deep/90 text-sm text-white placeholder-brand-muted/60 rounded-full pl-10 pr-4 py-2 w-36 sm:w-48 focus:w-64 focus:outline-none border border-brand-border focus:border-brand-accent transition-all duration-300">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted group-focus-within:text-brand-gold text-xs transition-colors"></i>
                </div>

                <!-- Notifications Button -->
                <button onclick="showToast('No new notifications')" class="relative w-10 h-10 rounded-full bg-brand-deep hover:bg-brand-card border border-brand-border flex items-center justify-center text-brand-muted hover:text-white transition-all">
                    <i class="fa-regular fa-bell text-sm"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-brand-magenta animate-ping"></span>
                    <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-brand-magenta"></span>
                </button>

                <!-- Profile Avatar -->
                <button class="flex items-center gap-2 p-1 rounded-full border border-brand-accent/40 bg-brand-deep hover:border-brand-magenta transition-all">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-accent to-brand-magenta p-[2px]">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="Avatar" class="w-full h-full object-cover rounded-full">
                    </div>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <!-- 2. HERO / LANDING PAGE BANNER -->
        <section id="home" class="relative overflow-hidden bg-cosmic-gradient py-12 md:py-20 border-b border-brand-border/30">
            <!-- Background Nebula Glowing Lights -->
            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-accent/20 rounded-full blur-[120px] pointer-events-none animate-pulse-glow"></div>
            <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-magenta/20 rounded-full blur-[100px] pointer-events-none animate-pulse-glow" style="animation-delay: 2s;"></div>
            <div class="absolute top-10 right-10 w-64 h-64 bg-brand-gold/10 rounded-full blur-[90px] pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Hero Content Left -->
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-gold/10 border border-brand-gold/30 text-brand-gold text-xs font-bold tracking-widest uppercase">
                            <i class="fa-solid fa-sparkles text-xs"></i>
                            YOUR PERSONAL MOVIE UNIVERSE
                        </div>
                        
                        <h1 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-none">
                            Every Movie. <br>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-brand-violet to-brand-magenta">One Place.</span>
                        </h1>

                        <p class="text-brand-muted text-base sm:text-lg max-w-2xl font-normal leading-relaxed mx-auto lg:mx-0">
                            Track what you watch, save what's next, and keep your favorite cosmic stories close. Immerse yourself in a cinema experience curated specifically for your journey.
                        </p>

                        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
                            <a href="#movies" class="px-8 py-4 rounded-full bg-purple-btn hover:opacity-95 text-white font-bold text-sm tracking-wide shadow-cosmic-glow transform hover:-translate-y-0.5 transition-all flex items-center gap-2">
                                <i class="fa-solid fa-compass text-brand-gold"></i> Explore Movies
                            </a>
                            <button onclick="toggleWatchlist('hero-featured')" id="hero-watchlist-btn" class="px-7 py-4 rounded-full bg-brand-deep/80 hover:bg-brand-card border border-brand-accent/50 hover:border-brand-accent text-white font-semibold text-sm tracking-wide transition-all flex items-center gap-2 shadow-lg">
                                <i class="fa-solid fa-plus text-brand-magenta" id="hero-watchlist-icon"></i> <span id="hero-watchlist-text">Add Featured to Watchlist</span>
                            </button>
                        </div>

                        <!-- Mini Rating & Metrics Badge -->
                        <div class="pt-6 flex items-center justify-center lg:justify-start gap-8 border-t border-brand-border/40">
                            <div>
                                <div class="text-2xl font-black font-display text-white">10K+</div>
                                <div class="text-xs text-brand-muted">Titles Indexed</div>
                            </div>
                            <div class="w-px h-8 bg-brand-border/50"></div>
                            <div>
                                <div class="text-2xl font-black font-display text-brand-gold flex items-center gap-1">
                                    4.9 <i class="fa-solid fa-star text-xs"></i>
                                </div>
                                <div class="text-xs text-brand-muted">Community Score</div>
                            </div>
                            <div class="w-px h-8 bg-brand-border/50"></div>
                            <div>
                                <div class="text-2xl font-black font-display text-brand-magenta">100%</div>
                                <div class="text-xs text-brand-muted">Cinematic Magic</div>
                            </div>
                        </div>
                    </div>

                    <!-- Featured Movie Artwork Right -->
                    <div class="lg:col-span-5 relative flex justify-center">
                        <!-- Subtle Glow Container Behind Featured Poster -->
                        <div class="absolute -inset-1.5 bg-gradient-to-r from-brand-accent via-brand-magenta to-brand-gold rounded-3xl blur-xl opacity-70 animate-pulse-glow"></div>
                        
                        <div class="relative w-full max-w-md glass-card rounded-2xl overflow-hidden shadow-2xl border border-brand-accent/40 group hover:border-brand-magenta/60 transition-all duration-500">
                            <!-- Featured Label -->
                            <div class="absolute top-4 left-4 z-20 bg-brand-bg/90 backdrop-blur-md px-3 py-1 rounded-full border border-brand-gold/50 flex items-center gap-1.5 shadow-md">
                                <i class="fa-solid fa-crown text-brand-gold text-xs"></i>
                                <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">Featured Story</span>
                            </div>

                            <!-- Generated Canvas Artwork Poster -->
                            <div class="relative h-96 w-full overflow-hidden bg-brand-deep cursor-pointer" onclick="openMovieModal('hero-featured')">
                                <canvas id="featuredCanvas" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"></canvas>
                                <div class="absolute inset-0 bg-gradient-to-t from-brand-card via-transparent to-transparent"></div>
                                
                                <!-- Play/Details Floating Overlay Button -->
                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-brand-bg/40 backdrop-blur-xs">
                                    <span class="w-16 h-16 rounded-full bg-brand-magenta/90 text-white flex items-center justify-center shadow-magenta-glow transform scale-90 group-hover:scale-100 transition-transform">
                                        <i class="fa-solid fa-eye text-xl"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Featured Poster Info -->
                            <div class="p-6 space-y-3 bg-brand-card/90">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-accent/20 border border-brand-accent/40 text-brand-violet">Sci-Fi / Quantum</span>
                                    <div class="flex items-center gap-1 font-bold text-sm text-brand-gold">
                                        <i class="fa-solid fa-star gold-star"></i> 4.9 <span class="text-xs font-normal text-brand-muted">(2.4k)</span>
                                    </div>
                                </div>

                                <h3 class="font-display font-bold text-2xl text-white group-hover:text-brand-violet transition-colors">Chronos: Edge of Infinity</h3>

                                <div class="flex items-center gap-4 text-xs font-medium text-brand-muted">
                                    <span><i class="fa-regular fa-calendar text-brand-accent mr-1"></i> 2026</span>
                                    <span><i class="fa-regular fa-clock text-brand-accent mr-1"></i> 2h 42m</span>
                                    <span><i class="fa-solid fa-film text-brand-accent mr-1"></i> 8K IMAX</span>
                                </div>

                                <p class="text-xs text-brand-muted/90 line-clamp-2">
                                    When the timeline fragments following a cosmic tear, a rogue navigator must traverse dying star systems to prevent the total collapse of existence.
                                </p>

                                <div class="pt-2 flex items-center justify-between border-t border-brand-border/40 text-xs">
                                    <span class="text-brand-muted">Director: <strong class="text-white">Aria Vance</strong></span>
                                    <button onclick="openMovieModal('hero-featured')" class="text-brand-magenta hover:text-white font-bold flex items-center gap-1">
                                        Full Details <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 3. MOVIE COLLECTION STATISTICS -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                
                <!-- Stat Card 1 -->
                <div class="glass-card rounded-2xl p-5 border border-brand-border/60 hover:border-brand-accent/60 transition-all shadow-card-depth flex items-center gap-4 group">
                    <div class="w-12 h-12 rounded-xl bg-brand-accent/20 border border-brand-accent/40 flex items-center justify-center text-brand-violet text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-clapperboard"></i>
                    </div>
                    <div>
                        <div class="font-display font-black text-2xl text-white" id="stat-total">50</div>
                        <div class="text-xs font-medium text-brand-muted uppercase tracking-wider">Total Movies</div>
                    </div>
                </div>

                <!-- Stat Card 2 -->
                <div class="glass-card rounded-2xl p-5 border border-brand-border/60 hover:border-brand-accent/60 transition-all shadow-card-depth flex items-center gap-4 group">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <div class="font-display font-black text-2xl text-white" id="stat-watched">32</div>
                        <div class="text-xs font-medium text-brand-muted uppercase tracking-wider">Watched</div>
                    </div>
                </div>

                <!-- Stat Card 3 -->
                <div class="glass-card rounded-2xl p-5 border border-brand-border/60 hover:border-brand-accent/60 transition-all shadow-card-depth flex items-center gap-4 group">
                    <div class="w-12 h-12 rounded-xl bg-brand-magenta/20 border border-brand-magenta/40 flex items-center justify-center text-brand-magenta text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-bookmark"></i>
                    </div>
                    <div>
                        <div class="font-display font-black text-2xl text-white" id="stat-towatch">15</div>
                        <div class="text-xs font-medium text-brand-muted uppercase tracking-wider">To Watch</div>
                    </div>
                </div>

                <!-- Stat Card 4 -->
                <div class="glass-card rounded-2xl p-5 border border-brand-border/60 hover:border-brand-accent/60 transition-all shadow-card-depth flex items-center gap-4 group">
                    <div class="w-12 h-12 rounded-xl bg-brand-gold/20 border border-brand-gold/40 flex items-center justify-center text-brand-gold text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                    <div>
                        <div class="font-display font-black text-2xl text-white" id="stat-favorites">8</div>
                        <div class="text-xs font-medium text-brand-muted uppercase tracking-wider">Favorites</div>
                    </div>
                </div>

            </div>
        </section>

        <!-- 4. POPULAR MOVIES SECTION -->
        <section id="movies" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-white flex items-center gap-3">
                        <span class="w-2 h-7 rounded-full bg-gradient-to-b from-brand-accent to-brand-magenta inline-block"></span>
                        Popular Movies
                    </h2>
                    <p class="text-brand-muted text-xs sm:text-sm mt-1">Highest rated space operas & multidimensional thrillers</p>
                </div>
                <a href="#movies" class="text-sm font-semibold text-brand-violet hover:text-brand-magenta flex items-center gap-1 transition-colors">
                    View All <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>

            <!-- Popular Grid (5 Cards Row) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6" id="popularGrid">
                <!-- Javascript will populate dynamic movie cards -->
            </div>
        </section>

        <!-- 5. BROWSE BY GENRE -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-brand-border/30">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 class="font-display font-extrabold text-2xl text-white flex items-center gap-3">
                        <span class="w-2 h-7 rounded-full bg-brand-gold inline-block"></span>
                        Explore by Genre
                    </h2>
                    <p class="text-brand-muted text-xs sm:text-sm mt-1">Filter titles by cosmic category</p>
                </div>
                
                <!-- Active Filter Counter -->
                <div class="text-xs text-brand-muted bg-brand-card/80 px-3 py-1.5 rounded-full border border-brand-border self-start md:self-auto">
                    Showing: <span id="genreFilterCount" class="text-brand-gold font-bold">All Categories</span>
                </div>
            </div>

            <!-- Pill Filters Row -->
            <div class="flex items-center gap-2.5 overflow-x-auto pb-4 scrollbar-none" id="genreContainer">
                <!-- Genre buttons dynamically inserted -->
            </div>
        </section>

        <!-- 6. RECENTLY ADDED SECTION -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-white flex items-center gap-3">
                        <span class="w-2 h-7 rounded-full bg-brand-magenta inline-block"></span>
                        Recently Added
                    </h2>
                    <p class="text-brand-muted text-xs sm:text-sm mt-1">Fresh additions to your personal timeline</p>
                </div>
                <div class="flex items-center gap-2">
                    <button class="w-8 h-8 rounded-full bg-brand-card hover:bg-brand-accent/40 border border-brand-border text-white text-xs transition-colors flex items-center justify-center">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="w-8 h-8 rounded-full bg-brand-card hover:bg-brand-accent/40 border border-brand-border text-white text-xs transition-colors flex items-center justify-center">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Recently Added Row -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6" id="recentGrid">
                <!-- Populated via Javascript -->
            </div>
        </section>
    </main>

    <!-- 7. FOOTER -->
    <footer class="bg-brand-deep border-t border-brand-border/50 text-brand-muted py-12 relative overflow-hidden">
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-32 bg-gradient-to-t from-brand-accent/10 to-transparent pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
                <!-- Col 1: Brand Info -->
                <div class="space-y-4 md:col-span-1">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-accent via-brand-magenta to-brand-gold p-[2px]">
                            <div class="w-full h-full bg-brand-bg rounded-[10px] flex items-center justify-center">
                                <i class="fa-solid fa-film text-brand-gold text-sm"></i>
