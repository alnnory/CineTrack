                default: return 'bg-brand-magenta/20 text-brand-magenta border border-brand-magenta/30';
            }
        }

        // Render Popular and Recent grids
        function renderGrids() {
            const popularGrid = document.getElementById('popularGrid');
            const recentGrid = document.getElementById('recentGrid');

            // Filter movies by active genre
            const filtered = movieData.filter(m => activeGenre === 'All' || m.genre === activeGenre);

            const popularList = filtered.filter(m => m.popular);
            const recentList = filtered.filter(m => m.recent || !m.popular);

            if (popularGrid) {
                if (popularList.length === 0) {
                    popularGrid.innerHTML = `<div class="col-span-full py-12 text-center text-brand-muted text-sm glass-card rounded-2xl">No popular titles found for genre: <strong class="text-white">${activeGenre}</strong></div>`;
                } else {
                    popularGrid.innerHTML = popularList.map(m => createMovieCardHTML(m)).join('');
                    popularList.forEach(m => renderPosterCanvas(`canvas-${m.id}`, m.colors, m.title));
                }
            }

            if (recentGrid) {
                if (recentList.length === 0) {
                    recentGrid.innerHTML = `<div class="col-span-full py-12 text-center text-brand-muted text-sm glass-card rounded-2xl">No recent additions for genre: <strong class="text-white">${activeGenre}</strong></div>`;
                } else {
                    recentGrid.innerHTML = recentList.map(m => createMovieCardHTML(m)).join('');
                    recentList.forEach(m => renderPosterCanvas(`canvas-${m.id}`, m.colors, m.title));
                }
            }
        }

        // Render Genre Filter Buttons
        function renderGenreButtons() {
            const container = document.getElementById('genreContainer');
            if (!container) return;

            container.innerHTML = genres.map(g => {
                const isActive = g === activeGenre;
                return `
                    <button onclick="selectGenre('${g}')" 
                            class="px-5 py-2 rounded-full text-xs font-bold transition-all whitespace-nowrap shadow-sm ${
                                isActive 
                                ? 'bg-purple-btn text-white shadow-cosmic-glow scale-105' 
                                : 'bg-brand-card hover:bg-brand-cardHover border border-brand-border/60 text-brand-muted hover:text-white'
                            }">
                        ${g}
                    </button>
                `;
            }).join('');

            const countEl = document.getElementById('genreFilterCount');
            if (countEl) countEl.innerText = activeGenre === 'All' ? 'All Categories' : activeGenre;
        }

        function selectGenre(genre) {
            activeGenre = genre;
            renderGenreButtons();
            renderGrids();
