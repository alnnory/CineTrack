<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineTrack — Your Movies. Your Story.</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#0B0614',
                            deep: '#130A20',
                            card: '#211432',
                            elevated: '#2B1940',
                            cardHover: '#341E4E',
                            purple: '#7B2CDB',
                            violet: '#A855F7',
                            magenta: '#EC168C',
                            hotpink: '#FF3DBB',
                            gold: '#F5C542',
                            text: '#FFFFFF',
                            secondary: '#C4B8D4',
                            muted: '#8E829F',
                            border: '#3B205C'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    boxShadow: {
                        'cosmic-glow': '0 0 35px -5px rgba(123, 44, 219, 0.5), 0 0 20px -5px rgba(236, 22, 140, 0.35)',
                        'magenta-glow': '0 0 25px 0px rgba(236, 22, 140, 0.45)',
                        'pink-glow': '0 0 30px 2px rgba(255, 61, 187, 0.4)',
                        'gold-glow': '0 0 20px 0px rgba(245, 197, 66, 0.35)',
                        'card-depth': '0 15px 35px -10px rgba(0, 0, 0, 0.75)',
                    },
                    backgroundImage: {
                        'hero-glow': 'radial-gradient(ellipse at 50% 30%, rgba(236, 22, 140, 0.22) 0%, rgba(123, 44, 219, 0.3) 35%, rgba(19, 10, 32, 0.95) 75%, rgba(11, 6, 20, 1) 100%)',
                        'purple-magenta-btn': 'linear-gradient(135deg, #EC168C 0%, #7B2CDB 100%)',
                        'violet-pink-btn': 'linear-gradient(135deg, #A855F7 0%, #FF3DBB 100%)',
                        'card-gradient': 'linear-gradient(180deg, rgba(43, 25, 64, 0.7) 0%, rgba(33, 20, 50, 0.9) 100%)',
                        'glow-line': 'linear-gradient(90deg, transparent 0%, #EC168C 30%, #A855F7 70%, transparent 100%)'
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0614;
        }
        ::-webkit-scrollbar-thumb {
            background: #2B1940;
            border-radius: 4px;
            border: 1px solid #3B205C;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7B2CDB;
        }

        /* Ambient Animations */
        @keyframes pulseAura {
            0%, 100% { opacity: 0.5; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.04); }
        }
        .animate-aura {
            animation: pulseAura 8s infinite ease-in-out;
        }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        .animate-float {
            animation: floatSlow 6s infinite ease-in-out;
        }

        /* Glassmorphic Utilities */
        .glass-nav {
            background: rgba(11, 6, 20, 0.82);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(123, 44, 219, 0.25);
        }

        .glass-card {
            background: rgba(33, 20, 50, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(123, 44, 219, 0.22);
        }
        .glass-card:hover {
            border-color: rgba(236, 22, 140, 0.45);
            box-shadow: 0 10px 30px -5px rgba(123, 44, 219, 0.3);
        }

        .gold-star-glow {
            color: #F5C542;
            text-shadow: 0 0 10px rgba(245, 197, 66, 0.6);
        }

        /* Hide scrollbars for sliders */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

