                genre: 'Sci-Fi',
                rating: 4.8,
                status: 'In Watchlist',
                overview: 'Deep space explorers discover a cosmic rift leading to an infinite ocean of sentient starlight guarding ancient galactic secrets.',
                colors: ['#00F2FE', '#A855F7', '#130A20', '#EC168C']
            },
            {
                id: 'm3',
                title: 'Neon Cyberpunk 2099',
                year: '2026',
                genre: 'Action',
                rating: 4.7,
                status: 'Watched',
                overview: 'In a neon-drenched high-orbit megacity, a rogue courier uncovers a clandestine AI syndicate controlling human memories.',
                colors: ['#FF0844', '#FF3DBB', '#0B0614', '#F5C542']
            },
            {
                id: 'm4',
                title: 'Velvet Shadow',
                year: '2024',
                genre: 'Action',
                rating: 4.6,
                status: 'In Watchlist',
                overview: 'An exiled operative navigates a web of high-stakes deception across European capitals to retrieve a stolen biological key.',
                colors: ['#43CBFF', '#7B2CDB', '#130A20', '#A855F7']
            },
            {
                id: 'm5',
                title: 'Aetheria: Lost City',
                year: '2025',
                genre: 'Fantasy',
                rating: 4.9,
                status: 'Watched',
                overview: 'A guild of celestial alchemists journeys to ignite a dying magical sun inside a subterranean floating city.',
                colors: ['#F5C542', '#EC168C', '#211432', '#FF3DBB']
            }
        ];

        // Render Procedural Poster Art on HTML5 Canvas
        function drawPoster(canvasId, colors, titleText) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            canvas.width = 300;
            canvas.height = 450;

            const c1 = colors[0] || '#7B2CDB';
            const c2 = colors[1] || '#EC168C';
            const c3 = colors[2] || '#0B0614';
            const c4 = colors[3] || '#F5C542';

            // Background
            const bgGrad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            bgGrad.addColorStop(0, c3);
            bgGrad.addColorStop(0.5, c1);
            bgGrad.addColorStop(1, c3);
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Swirling Orbs
            for (let i = 0; i < 3; i++) {
                ctx.save();
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = 60 + Math.random() * 80;
                const radGrad = ctx.createRadialGradient(x, y, 10, x, y, r);
                radGrad.addColorStop(0, c2);
                radGrad.addColorStop(1, 'transparent');
                ctx.fillStyle = radGrad;
                ctx.globalAlpha = 0.4;
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Star Particles
            ctx.fillStyle = '#FFFFFF';
            for (let i = 0; i < 60; i++) {
                const sx = Math.random() * canvas.width;
                const sy = Math.random() * canvas.height;
                ctx.globalAlpha = Math.random() * 0.8;
                ctx.fillRect(sx, sy, 1.5, 1.5);
            }

            // Central Ring Emblem
            ctx.save();
            ctx.translate(canvas.width / 2, canvas.height / 2 - 20);
            ctx.strokeStyle = c4;
            ctx.lineWidth = 1.5;
            ctx.globalAlpha = 0.4;
            ctx.beginPath();
            ctx.arc(0, 0, 65, 0, Math.PI * 2);
            ctx.stroke();

            ctx.rotate(45 * Math.PI / 180);
            ctx.strokeStyle = c2;
            ctx.strokeRect(-35, -35, 70, 70);
            ctx.restore();

            // Bottom Gradient Overlay for typography legibility
            const botGrad = ctx.createLinearGradient(0, canvas.height - 140, 0, canvas.height);
            botGrad.addColorStop(0, 'transparent');
            botGrad.addColorStop(1, '#0B0614');
            ctx.fillStyle = botGrad;
            ctx.globalAlpha = 0.95;
            ctx.fillRect(0, canvas.height - 150, canvas.width, 150);

            // Poster Title
            ctx.globalAlpha = 1.0;
            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 18px Outfit, sans-serif';
            ctx.textAlign = 'center';

            const words = titleText.split(' ');
            if (words.length > 2) {
                ctx.fillText(words.slice(0, 2).join(' '), canvas.width / 2, canvas.height - 50);
                ctx.fillStyle = c4;
                ctx.fillText(words.slice(2).join(' '), canvas.width / 2, canvas.height - 25);
            } else {
                ctx.fillText(titleText, canvas.width / 2, canvas.height - 35);
            }
        }

        // Render Showcase Grid
        function renderShowcase(movies) {
            const grid = document.getElementById('movieGrid');
            if (!grid) return;

            grid.innerHTML = movies.map(m => `
                <div class="glass-card rounded-2xl overflow-hidden border border-brand-border hover:border-brand-magenta transition-all duration-300 flex flex-col justify-between group cursor-pointer" onclick="openMovieModal('${m.id}')">
                    <div class="relative aspect-[2/3] w-full overflow-hidden bg-brand-deep">
                        <canvas id="poster-${m.id}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"></canvas>
                        
                        <div class="absolute top-3 left-3 z-10 bg-brand-bg/80 backdrop-blur-md px-2.5 py-0.5 rounded-full border border-brand-purple/40 text-[10px] font-bold text-white">
                            ${m.genre}
                        </div>

                        <div class="absolute top-3 right-3 z-10 bg-brand-bg/80 backdrop-blur-md px-2 py-0.5 rounded-full border border-brand-gold/40 text-[10px] font-bold text-brand-gold flex items-center gap-1">
                            <i class="fa-solid fa-star gold-star-glow text-[9px]"></i> ${m.rating}
                        </div>

                        <div class="absolute inset-0 bg-brand-bg/40 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                            <span class="px-3.5 py-1.5 rounded-full bg-brand-purple text-white font-bold text-xs shadow-cosmic-glow">
                                View Details
                            </span>
                        </div>
                    </div>

                    <div class="p-4 bg-brand-card/90 flex-grow flex flex-col justify-between">
                        <div>
                            <div class="text-[10px] text-brand-muted mb-1">${m.year}</div>
                            <h3 class="font-display font-bold text-sm text-white line-clamp-1 group-hover:text-brand-violet transition-colors">
                                ${m.title}
                            </h3>
                        </div>
                        <div class="pt-3 border-t border-brand-border/30 mt-2 flex items-center justify-between text-[10px]">
                            <span class="px-2 py-0.5 rounded ${m.status === 'Watched' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-brand-purple/20 text-brand-violet'} font-semibold">
                                ${m.status}
                            </span>
                            <i class="fa-solid fa-chevron-right text-brand-muted group-hover:text-white"></i>
                        </div>
                    </div>
                </div>
            `).join('');

            // Draw Canvas Artworks
            movies.forEach(m => drawPoster(`poster-${m.id}`, m.colors, m.title));
        }

        function filterShowcase(genre) {
            const buttons = document.querySelectorAll('#showcaseFilters button');
            buttons.forEach(btn => {
                if (btn.innerText.includes(genre) || (genre === 'All' && btn.innerText.includes('All'))) {
                    btn.className = 'filter-btn active px-4 py-1.5 rounded-full text-xs font-bold bg-brand-purple text-white shadow-cosmic-glow';
                } else {
                    btn.className = 'filter-btn px-4 py-1.5 rounded-full text-xs font-bold bg-brand-card hover:bg-brand-elevated text-brand-secondary hover:text-white border border-brand-border';
                }
            });

            const filtered = genre === 'All' ? fictionalMovies : fictionalMovies.filter(m => m.genre === genre);
            renderShowcase(filtered);
        }

        // Modal Logic
        function openMovieModal(id) {
            const movie = fictionalMovies.find(m => m.id === id);
            if (!movie) return;

            document.getElementById('modalTitle').innerText = movie.title;
            document.getElementById('modalGenre').innerText = movie.genre;
            document.getElementById('modalYear').innerText = movie.year;
            document.getElementById('modalOverview').innerText = movie.overview;
            document.getElementById('modalRating').innerHTML = `<i class="fa-solid fa-star gold-star-glow"></i> ${movie.rating}`;
            document.getElementById('modalStatus').innerText = `Status: ${movie.status}`;

            drawPoster('modalCanvas', movie.colors, movie.title);

            const modal = document.getElementById('movieModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeMovieModal() {
            const modal = document.getElementById('movieModal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // Mobile Menu Drawer Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
        }

        // Toast Notifications
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            if (!toast || !toastMsg) return;

            toastMsg.innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function triggerCTA(action) {
            showToast(`CineTrack Platform Access Requested: ${action}`);
        }

        // Interactive Cosmic Particle Background Engine
        function initCosmicCanvas() {
            const canvas = document.getElementById('cosmicCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            let width = canvas.width = canvas.parentElement.clientWidth;
            let height = canvas.height = canvas.parentElement.clientHeight;

            window.addEventListener('resize', () => {
                if (canvas.parentElement) {
                    width = canvas.width = canvas.parentElement.clientWidth;
                    height = canvas.height = canvas.parentElement.clientHeight;
                }
            });

            const particles = [];
            const particleCount = 65;

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    radius: Math.random() * 2 + 0.5,
                    color: Math.random() > 0.5 ? '#A855F7' : (Math.random() > 0.5 ? '#EC168C' : '#F5C542'),
                    alpha: Math.random() * 0.7 + 0.2,
                    vx: (Math.random() - 0.5) * 0.3,
                    vy: (Math.random() - 0.5) * 0.3
                });
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);

                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                });

                requestAnimationFrame(animate);
            }

            animate();
        }

        window.onload = function() {
            initCosmicCanvas();
            renderShowcase(fictionalMovies);
        };
    </script>
</body>
</html>
